[Unit]
Description=restic rest-server (MediaSync backups)
After=network.target
# target-setup.sh fills in @DATA@, the backup folder. Never write backups onto the system disk
# when their drive is missing: no drive (so no folder), no service.
RequiresMountsFor=@DATA@
ConditionPathIsDirectory=@DATA@

[Service]
# Append-only: clients can add snapshots but not delete or rewrite them, so a mistake (or malware)
# on the MediaSync server can't destroy its backups. Each login only reaches the repository of its name.
ExecStart=/usr/local/bin/rest-server --path @DATA@ --listen 127.0.0.1:8000 \
    --append-only --private-repos --htpasswd-file /etc/rest-server/htpasswd
Restart=on-failure

User=restic
Group=restic
UMask=0077

# Network: loopback only; `tailscale serve` publishes it on the tailnet with HTTPS.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Sandboxing
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=@DATA@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
